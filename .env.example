# From the Zoom Marketplace app (App Credentials)
ZOOM_APP_CLIENT_ID=
ZOOM_APP_CLIENT_SECRET=
# Must exactly match the OAuth Redirect URL set in the Marketplace
ZOOM_APP_REDIRECT_URI=https://YOUR-DOMAIN/auth
# Secret code key (8+ plain ASCII characters). Used by the server for both the /code form and the matcher.
CODE_KEY=
# Link shown to parents who have no code yet. Use https://YOUR-DOMAIN/code
FORM_URL=
# Leave at 0. Set to 1 only for your very first live test if the host role is missing from Zoom's context (see SETUP.md).
ALLOW_CLIENT_ROLE=0
PORT=3000
